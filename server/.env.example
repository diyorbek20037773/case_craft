# Sud trenajyori backend sozlamalari. Nusxa: cp .env.example .env  (.env git'ga tushmaydi)
# Kalit bo'sh bo'lsa provayder avtomatik mock/none ga o'tadi — xato bermaydi.

# LLM: auto | gemini | anthropic | mock   (auto: Gemini kaliti -> ANTHROPIC_API_KEY -> mock)
LLM_PROVIDER=auto
# Gemini kalitlari navbati (https://aistudio.google.com/apikey): #1, #2, #3 ... tartibida ishlatiladi.
# Yaroqsiz (400 API_KEY_INVALID / 403) kalit sessiya davomida o'tkazib yuboriladi, 429 bergani 60 s dam oladi.
# Bo'sh qatorlar e'tiborsiz; bo'shliqli yoki juda uzun qiymat ogohlantirish bilan tashlanadi.
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
# Ixtiyoriy: yana kalitlar vergul bilan (yuqoridagilardan keyin ishlatiladi)
GEMINI_API_KEYS=
# 2026-11-20 tekshiruvi: gemini-flash-latest free tierda kuniga 20 so'rov va tez-tez 503 — demo uchun yaramaydi.
# gemini-3.1-flash-lite: o'rtacha ~2.3 s. Zaxira (404/503/timeout bo'lsa): gemini-flash-lite-latest (= 3.5-flash-lite).
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_S=8

# STT: auto | gemini | aisha | none   (auto: Gemini kaliti bo'lsa gemini flash-lite audio, Aisha kaliti bo'lsa zaxira)
STT_PROVIDER=auto
AISHA_API_KEY=

# TTS: auto | edge | azure | none   (auto: AZURE_SPEECH_KEY bo'lsa azure, aks holda edge)
TTS_PROVIDER=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_TIMEOUT_S=8
# deferred: /turn matnni darhol qaytaradi, audio_url (/tts/<kalit>.mp3) so'ralganda yaratiladi. inline: /turn ichida.
TTS_MODE=deferred
# Server ishga tushganda tayyor iboralar (ogohlantirishlar, bosqich e'lonlari) mp3 keshini fon rejimida tayyorlash
TTS_PREWARM=1

# Frontend manzillari (vergul bilan). localhost:5173 va *.vercel.app doim ruxsat etilgan.
CORS_ORIGINS=http://localhost:5173
# audio_url uchun tashqi manzil (masalan https://sud-api.up.railway.app). Bo'sh bo'lsa so'rov manzilidan olinadi.
PUBLIC_BASE_URL=

# Kontent papkasi (bo'sh: ../content, u yerda fayl bo'lmasa server/fixtures)
CONTENT_DIR=

# O'qituvchi paneli PIN (web/teacher.html, header x-teacher-pin). Standart: 1234
TEACHER_PIN=1234
